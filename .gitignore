# Local Terraform cache
**/.terraform/*

# State files
*.tfstate
*.tfstate.*

# Crash logs
crash.log
crash.*.log

# Override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Variable files that may hold real values or secrets
*.tfvars
*.tfvars.json

# CLI config
.terraformrc
terraform.rc
